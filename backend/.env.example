APP_NAME=Findriva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Findriva crawler (see docs/roadmap.md)
FINDRIVA_CRAWLER_UA="FindrivaBot/0.1 (+https://findriva.com/bot)"
FINDRIVA_CRAWLER_MAX_DEPTH=3
FINDRIVA_CRAWLER_TIMEOUT=10
FINDRIVA_CRAWLER_MAX_BYTES=2097152
FINDRIVA_CRAWLER_MAX_RUNTIME=300
FINDRIVA_CRAWLER_DELAY_MS=250
# Development only. Lets the crawler reach a site on localhost. Ignored when APP_ENV=production.
FINDRIVA_CRAWLER_ALLOW_PRIVATE=false

# Public business pages (https://findriva.com/b/{slug})
FINDRIVA_PUBLIC_URL="${APP_URL}"

# Keyword data. Leave empty for "seeds only" (volumes shown as not measured).
FINDRIVA_KEYWORD_PROVIDER=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Content Studio: template (facts only) or claude (needs ANTHROPIC_API_KEY)
FINDRIVA_CONTENT_GENERATOR=template
FINDRIVA_CLAUDE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=

# Google Search Console (read-only OAuth). The redirect URI must match the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/api/v1/integrations/google/callback"
FINDRIVA_APP_URL=
# IndexNow key for Findriva's own public pages (any 32 letters/digits).
FINDRIVA_INDEXNOW_KEY=

# Email (verification, password reset). Use MAIL_MAILER=resend with RESEND_API_KEY in production,
# and a verified sending domain in MAIL_FROM_ADDRESS.
RESEND_API_KEY=

# Billing with Paystack (NGN). Webhook URL: ${APP_URL}/api/v1/billing/paystack/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# Optional Paystack plan codes for automatic monthly renewal (PLN_...). Without them each payment buys one month.
PAYSTACK_PLAN_STARTER=
PAYSTACK_PLAN_GROWTH=
PAYSTACK_PLAN_AGENCY=
# Monthly prices in kobo (990000 = ₦9,900)
FINDRIVA_PRICE_STARTER=990000
FINDRIVA_PRICE_GROWTH=2990000
FINDRIVA_PRICE_AGENCY=9900000

# Live search positions (weekly) for tracked keywords. Defaults to the keyword provider, so one DataForSEO login covers both.
FINDRIVA_SERP_PROVIDER=
FINDRIVA_SERP_DEPTH=30

# AI answer visibility (uses ANTHROPIC_API_KEY). Leave the engine empty to switch checks off.
FINDRIVA_AI_ANSWER_ENGINE=claude
FINDRIVA_AI_ANSWER_MODEL=claude-opus-5-5
