APP_NAME=Findriva
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Findriva crawler (see docs/roadmap.md)
FINDRIVA_CRAWLER_UA="FindrivaBot/0.1 (+https://findriva.com/bot)"
FINDRIVA_CRAWLER_MAX_DEPTH=3
FINDRIVA_CRAWLER_TIMEOUT=10
FINDRIVA_CRAWLER_MAX_BYTES=2097152
FINDRIVA_CRAWLER_MAX_RUNTIME=300
FINDRIVA_CRAWLER_DELAY_MS=250
# Development only. Lets the crawler reach a site on localhost. Ignored when APP_ENV=production.
FINDRIVA_CRAWLER_ALLOW_PRIVATE=false

# Public business pages (https://findriva.com/b/{slug})
FINDRIVA_PUBLIC_URL="${APP_URL}"

# Keyword data. Leave empty for "seeds only" (volumes shown as not measured).
FINDRIVA_KEYWORD_PROVIDER=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Content Studio: template (facts only) or claude (needs ANTHROPIC_API_KEY)
FINDRIVA_CONTENT_GENERATOR=template
FINDRIVA_CLAUDE_MODEL=claude-opus-5-5
ANTHROPIC_API_KEY=
